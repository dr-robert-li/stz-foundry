{"kb": "prime", "query_id": 274, "hf_revision": "88269e23e90587f99476c5dd74e235a0877e69be", "metrics": {"mrr": 1.0, "hit@1": 1.0, "hit@5": 1.0, "recall@20": 1.0}}

